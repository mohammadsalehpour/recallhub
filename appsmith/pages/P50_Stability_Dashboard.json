{
  "pageName": "P50_Stability_Dashboard",
  "purpose": "Production stabilization dashboard.",
  "visible": "{{JS_AppShell.isAdmin()}}",
  "onPageLoad": ["qStabilityHealth.run"],
  "widgets": [
    { "name": "kpiProjectCount", "type": "StatBox", "value": "{{qStabilityHealth.data?.data?.projects || 0}}" },
    { "name": "kpiStaleRuns", "type": "StatBox", "value": "{{qStabilityHealth.data?.data?.stale_workflow_runs || 0}}" },
    { "name": "tblRunStatusBreakdown", "type": "Table", "data": "{{qStabilityHealth.data?.data?.workflow_runs_by_status || []}}" },
    { "name": "inpStaleMinutes", "type": "Input", "inputType": "number" },
    { "name": "mdlConfirmReconcile", "type": "Modal", "confirmAction": "qStabilityReconcile.run(() => qStabilityHealth.run())" },
    { "name": "btnReconcile", "type": "Button", "disabled": "{{!JS_AppShell.isAdmin()}}", "onClick": "JS_AppShell.requireAdmin() && showModal('mdlConfirmReconcile')" },
    { "name": "btnRefreshStability", "type": "IconButton", "icon": "refresh-ccw", "onClick": "qStabilityHealth.run()" }
  ],
  "queries": ["qStabilityHealth", "qStabilityReconcile"],
  "jsObjects": ["JS_AppShell"],
  "rules": ["Reconcile requires admin/owner/ops role and confirm modal."]
}
