{
  "pageName": "P01_Login",
  "purpose": "Token and environment bootstrap.",
  "onPageLoad": ["JS_AppShell.startupFromUrl"],
  "widgets": [
    { "name": "inpToken", "type": "Input", "inputType": "password", "label": "API Token", "required": true },
    { "name": "inpApiBaseUrl", "type": "Input", "label": "API Base URL", "placeholder": "http://api:3000/api/v1" },
    { "name": "selActiveRole", "type": "Select", "label": "Role", "options": ["operator", "admin", "owner", "ops"], "onOptionChange": "JS_AppShell.setRole(selActiveRole.selectedOptionValue)" },
    { "name": "inpActiveUserId", "type": "Input", "label": "Actor UUID" },
    { "name": "btnSaveToken", "type": "Button", "label": "Save", "onClick": "JS_AppShell.saveToken()" },
    { "name": "btnSaveApiBaseUrl", "type": "Button", "label": "Save URL", "onClick": "JS_AppShell.saveApiBaseUrl()" },
    { "name": "btnSaveUserId", "type": "Button", "label": "Save Actor", "onClick": "JS_AppShell.setActiveUserId()" },
    { "name": "btnLogout", "type": "Button", "label": "Logout", "onClick": "JS_AppShell.logout()" }
  ],
  "queries": ["qAuthStoreToken", "qAuthClearToken"],
  "jsObjects": ["JS_AppShell"],
  "security": ["Token is stored only in appsmith.store.token.", "No token literal is stored in JS or query files."]
}
