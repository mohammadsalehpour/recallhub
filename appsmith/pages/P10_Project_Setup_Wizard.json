{
  "pageName": "P10_Project_Setup_Wizard",
  "purpose": "Create a project profile, bind a repository, define scan paths/config files, validate and sync.",
  "onPageLoad": ["JS_AppShell.startupFromUrl", "qProjectList.run"],
  "layout": [
    {
      "section": "Project",
      "widgets": [
        { "name": "tblProjects", "type": "Table", "data": "{{JS_AppShell.projectRows()}}", "onRowSelected": "JS_ProjectFlow.selectProject(tblProjects.selectedRow)" },
        { "name": "inpProjectCode", "type": "Input", "required": true },
        { "name": "inpProjectName", "type": "Input", "required": true },
        { "name": "inpProjectDescription", "type": "Input", "required": true, "inputType": "multiline" },
        { "name": "selBusinessDomain", "type": "Select", "options": ["ERP", "CRM", "ecommerce", "internal-tool", "other"] },
        { "name": "inpFrameworkName", "type": "Input", "required": true },
        { "name": "inpFrameworkVersion", "type": "Input", "required": true },
        { "name": "tblTechStack", "type": "Table", "editable": true, "columns": ["category", "name", "version", "source", "notes"] },
        { "name": "btnCreateProject", "type": "Button", "onClick": "JS_ProjectFlow.createProjectWizardFlow()" }
      ]
    },
    {
      "section": "Repository",
      "widgets": [
        { "name": "tblRepositories", "type": "Table", "data": "{{qRepositoryList.data}}", "onRowSelected": "JS_ProjectFlow.selectRepository(tblRepositories.selectedRow)" },
        { "name": "inpRepoName", "type": "Input", "required": true },
        { "name": "selRepoLocatorType", "type": "Select", "required": true, "options": ["local_path"] },
        { "name": "inpRepoRoot", "type": "Input", "required": true },
        { "name": "inpDefaultBranch", "type": "Input" },
        { "name": "btnCreateRepository", "type": "Button", "onClick": "JS_ProjectFlow.createRepository()" },
        { "name": "btnValidateRepository", "type": "Button", "disabled": "{{!appsmith.store.activeRepositoryId}}", "onClick": "JS_ProjectFlow.validateRepository()" }
      ]
    },
    {
      "section": "Paths",
      "widgets": [
        { "name": "tblPaths", "type": "Table", "data": "{{qPathList.data}}" },
        { "name": "inpPath", "type": "Input", "required": true },
        { "name": "inpPathLabel", "type": "Input" },
        { "name": "chkPathRequired", "type": "Checkbox" },
        { "name": "selPathType", "type": "Select", "required": true, "options": ["framework_core", "official_addons", "custom_addons", "owned_apps", "third_party_apps", "config", "docs", "tests", "scripts", "generated", "ignore"] },
        { "name": "selScanPolicy", "type": "Select", "required": true, "options": ["include", "exclude", "metadata_only"] },
        { "name": "selOwnership", "type": "Select", "required": true, "options": ["framework", "vendor", "team_owned", "generated", "unknown"] },
        { "name": "btnCreatePath", "type": "Button", "disabled": "{{!appsmith.store.activeRepositoryId}}", "onClick": "JS_ProjectFlow.createPath()" }
      ]
    },
    {
      "section": "Config Files",
      "widgets": [
        { "name": "tblConfigFiles", "type": "Table", "data": "{{qConfigList.data}}" },
        { "name": "inpConfigRelativePath", "type": "Input", "required": true },
        { "name": "inpConfigType", "type": "Input", "required": true },
        { "name": "chkConfigRequired", "type": "Checkbox" },
        { "name": "selContainsSecrets", "type": "Select", "required": true, "options": ["true", "false", "unknown"] },
        { "name": "selConfigScanPolicy", "type": "Select", "required": true, "options": ["metadata_only", "parse_safe", "exclude"] },
        { "name": "btnCreateConfigFile", "type": "Button", "disabled": "{{!appsmith.store.activeRepositoryId}}", "onClick": "JS_ProjectFlow.createConfigFile()" }
      ]
    },
    {
      "section": "Sync",
      "widgets": [
        { "name": "btnValidateAndSync", "type": "Button", "disabled": "{{!appsmith.store.activeProjectCode}}", "onClick": "JS_ProjectFlow.validateRepositoryAndSync()" }
      ]
    }
  ],
  "queries": ["qProjectList", "qProjectGet", "qProjectCreate", "qProjectTechStack", "qRepositoryList", "qRepoCreate", "qRepoValidate", "qPathList", "qPathCreate", "qConfigList", "qConfigCreate", "qProjectSync"],
  "jsObjects": ["JS_AppShell", "JS_ProjectFlow", "JS_RunMonitor"]
}
