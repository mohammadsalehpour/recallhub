[
  {
    "name": "qWorkItemList",
    "method": "GET",
    "path": "/projects/{{appsmith.store.activeProjectCode}}/work-items"
  },
  {
    "name": "qWorkItemCreate",
    "method": "POST",
    "path": "/projects/{{appsmith.store.activeProjectCode}}/work-items",
    "bodyTemplate": {
      "title": "{{inpWorkItemTitle.text}}",
      "original_request": "{{inpWorkItemRequest.text}}",
      "request_type": "{{selRequestType.selectedOptionValue}}",
      "risk_level": "{{selRiskLevel.selectedOptionValue}}",
      "priority": "{{selPriority.selectedOptionValue}}",
      "open_questions": "{{JS_WorkItemFlow.openQuestions()}}",
      "requested_by": "{{appsmith.store.activeUserId || undefined}}",
      "metadata": "{{JS_WorkItemFlow.createMetadata()}}"
    }
  },
  {
    "name": "qWorkItemContext",
    "method": "GET",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/context-packet"
  },
  {
    "name": "qWorkItemResearchStart",
    "method": "POST",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/research/start",
    "bodyTemplate": {
      "idempotencyKey": "{{appsmith.store.workItemActionKey}}",
      "triggeredBy": "{{appsmith.store.activeUserId || undefined}}",
      "input": "{{JS_WorkItemFlow.workflowInput()}}"
    }
  },
  {
    "name": "qWorkItemSpecStart",
    "method": "POST",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/spec/start",
    "bodyTemplate": {
      "idempotencyKey": "{{appsmith.store.workItemActionKey}}",
      "triggeredBy": "{{appsmith.store.activeUserId || undefined}}",
      "input": "{{JS_WorkItemFlow.workflowInput()}}"
    }
  },
  {
    "name": "qWorkItemApproval",
    "method": "POST",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/human-approval",
    "bodyTemplate": {
      "decision": "{{selApprovalDecision.selectedOptionValue}}",
      "reason": "{{inpApprovalReason.text}}",
      "actor_id": "{{appsmith.store.activeUserId || undefined}}"
    }
  },
  {
    "name": "qWorkItemImplementationPlan",
    "method": "POST",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/create-implementation-plan",
    "bodyTemplate": {
      "idempotencyKey": "{{appsmith.store.workItemActionKey}}",
      "triggeredBy": "{{appsmith.store.activeUserId || undefined}}",
      "input": "{{JS_WorkItemFlow.workflowInput()}}"
    }
  },
  {
    "name": "qWorkItemExecutionSimulate",
    "method": "POST",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/simulate-execution",
    "bodyTemplate": {
      "idempotencyKey": "{{appsmith.store.workItemActionKey}}",
      "triggeredBy": "{{appsmith.store.activeUserId || undefined}}",
      "input": "{{JS_WorkItemFlow.workflowInput()}}"
    }
  },
  {
    "name": "qWorkItemMemoryCommit",
    "method": "POST",
    "path": "/work-items/{{appsmith.store.activeWorkItemId}}/memory-commit",
    "bodyTemplate": {
      "title": "{{inpCommitTitle.text}}",
      "what_changed": "{{inpWhatChanged.text}}",
      "why_changed": "{{inpWhyChanged.text}}",
      "how_changed": "{{inpHowChanged.text}}",
      "files_touched": "{{JS_WorkItemFlow.filesTouched()}}",
      "modules_touched": "{{JS_WorkItemFlow.modulesTouched()}}",
      "commands_run": "{{JS_WorkItemFlow.commandsRun()}}",
      "validation_result": "{{JS_WorkItemFlow.validationResult()}}",
      "risks_remaining": "{{JS_WorkItemFlow.risksRemaining()}}",
      "created_by": "{{appsmith.store.activeUserId || undefined}}"
    }
  }
]
