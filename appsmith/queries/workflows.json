[
  { "name": "qWorkflowList", "method": "GET", "path": "/workflows" },
  { "name": "qWorkflowRunsList", "method": "GET", "path": "/workflow-runs" },
  { "name": "qWorkflowRunGet", "method": "GET", "path": "/workflow-runs/{{appsmith.store.activeRunId}}" },
  { "name": "qWorkflowRunEvents", "method": "GET", "path": "/workflow-runs/{{appsmith.store.activeRunId}}/events" },
  {
    "name": "qWorkflowRunCreate",
    "method": "POST",
    "path": "/workflows/{{selWorkflowCode.selectedOptionValue}}/run",
    "bodyTemplate": {
      "projectId": "{{appsmith.store.activeProjectId}}",
      "workItemId": "{{appsmith.store.activeWorkItemId}}",
      "idempotencyKey": "{{appsmith.store.workflowIdempotencyKey}}",
      "triggeredBy": "{{appsmith.store.activeUserId || undefined}}",
      "input": "{{JS_RunMonitor.manualWorkflowInput()}}"
    }
  },
  {
    "name": "qWorkflowRunRetry",
    "method": "POST",
    "path": "/workflow-runs/{{appsmith.store.activeRunId}}/retry"
  },
  {
    "name": "qWorkflowRunCancel",
    "method": "POST",
    "path": "/workflow-runs/{{appsmith.store.activeRunId}}/cancel"
  }
]
